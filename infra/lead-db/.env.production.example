# ═══════════════════════════════════════════════════════════
#  Dreamlab Lead DB — Environment Variables (PRODUCTION)
# ═══════════════════════════════════════════════════════════
#  Cara pakai di server:
#    cp .env.production.example .env
#    lalu isi LEAD_DB_PASSWORD (wajib, beda dari password lokal).
# ═══════════════════════════════════════════════════════════

# ── Database lead ──
LEAD_DB_USER=dreamlab1
# ⚠️ WAJIB diganti — password kuat, BEDA dari password lokal
LEAD_DB_PASSWORD=GANTI-PASSWORD-KUAT-LEAD
LEAD_DB_NAME=dreamlab

# ── Port ──
# Port host untuk db-lead (maintenance, hanya localhost server)
LEAD_DB_HOST_PORT=5433
# Port host untuk pgbouncer (diakses Vercel) — buka di firewall
LEAD_PGBOUNCER_PORT=6432
